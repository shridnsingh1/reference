import os
import re
from pathlib import Path

# 🧩 === Configuration ===
template_path = r"C:\Shailendra\TENNECO WORK\template.sql"   # 👈 Path to your template file
output_folder = r"C:\Shailendra\TENNECO WORK\Generated_SQL"  # 👈 Folder where new files will be created
table_names = ["Abn", "rig", "yurt"]                         # 👈 List of table names
# ========================


def clean_table_name(name: str) -> str:
    """Sanitize the table name for filenames and SQL usage."""
    return re.sub(r"[^A-Za-z0-9_-]", "_", name.strip())


def render_template(template_text: str, table_name: str) -> str:
    """Replace placeholders in the template."""
    return (
        template_text
        .replace("{{TABLE_NAME}}", table_name)
        .replace("{{TABLE_NAME_UPPER}}", table_name.upper())
        .replace("{{TABLE_NAME_LOWER}}", table_name.lower())
    )


def main():
    # Ensure output folder exists
    os.makedirs(output_folder, exist_ok=True)

    # Read the template file
    try:
        with open(template_path, "r", encoding="utf-8") as f:
            template_content = f.read()
    except Exception as e:
        print(f"❌ Error reading template: {e}")
        return

    # Generate files
    for table in table_names:
        clean_name = clean_table_name(table)
        rendered_sql = render_template(template_content, clean_name)

        # File name pattern: sp_tcs_stage_{table_name_lower}_scrf_insert.sql
        file_name = f"sp_tcs_stage_{clean_name.lower()}_scrf_insert.sql"
        output_file = Path(output_folder) / file_name

        try:
            with open(output_file, "w", encoding="utf-8") as f:
                f.write(rendered_sql)
            print(f"✅ Created: {output_file}")
        except Exception as e:
            print(f"⚠️  Failed to write {output_file}: {e}")

    print("\n🎯 All files generated successfully!")


if __name__ == "__main__":
    main()