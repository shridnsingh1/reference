import pandas as pd
from pathlib import Path

folder_path = Path(r"C:\Shailendra\TENNECO WORK\Generated_SQL")

file_list = [f.name for f in folder_path.glob("*.*")]
df = pd.DataFrame(file_list, columns=["FileName"])
df.to_csv(r"C:\Shailendra\TENNECO WORK\file_list.csv", index=False)

print("✅ File list saved to file_list.csv")